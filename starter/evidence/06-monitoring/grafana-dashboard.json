{
  "title": "FinBERT API — Service & Model Health",
  "uid": "finbert-api",
  "tags": ["finbert", "mlops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate (predictions/sec)",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(prediction_requests_total[1m]))",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "sum by (sentiment) (rate(prediction_requests_total[1m]))",
          "legendFormat": "{{sentiment}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Prediction latency percentiles (ms)",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(prediction_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(prediction_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Sentiment distribution (cumulative)",
      "id": 3,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "targets": [
        {
          "expr": "sum by (sentiment) (prediction_requests_total)",
          "legendFormat": "{{sentiment}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sentiment mix over time (%)",
      "id": 4,
      "gridPos": { "h": 8, "w": 10, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2, "fillOpacity": 30, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (sentiment) (rate(prediction_requests_total[5m])) / ignoring(sentiment) group_left sum(rate(prediction_requests_total[5m]))",
          "legendFormat": "{{sentiment}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (errors/sec)",
      "id": 5,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(prediction_errors_total[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Total predictions served",
      "id": 6,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(prediction_requests_total)", "refId": "A" }
      ]
    }
  ]
}
