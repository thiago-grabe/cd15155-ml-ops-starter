# ---------------------------------------------------------------------------
# Copy to .env and adjust.  Values are UNQUOTED on purpose: docker compose also
# auto-loads this file for compose-file interpolation, and quotes leak through.
# ---------------------------------------------------------------------------

# --- MLflow -----------------------------------------------------------------
# Inside the compose network, reach the tracking server by its service name.
# From your host (browser / host-run scripts) use http://localhost:5067 instead.
# The extra_hosts entry on the api service also allows http://host.docker.internal:5067
# if you prefer to run `mlflow server` on the host rather than in a container.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=finbert-evaluation
MODEL_NAME=finbert
# Alias resolved by app/utils.py -> models:/${MODEL_NAME}@${MODEL_STAGE}
# Must match the alias promote.py sets. Do NOT use "dev" — nothing sets that alias.
MODEL_STAGE=production

# --- Model source -----------------------------------------------------------
# "huggingface" -> load straight from the HF Hub (CI, ECS, and first local boot)
# "mlflow"      -> load from the MLflow Model Registry
# Start on huggingface: with "mlflow" the API lifespan crashes against an empty
# registry and compose restart-loops. Flip to "mlflow" after promote.py succeeds.
MODEL_SOURCE=huggingface
HF_MODEL_ID=baptle/FinBERT_market_based
HF_DATASET_ID=baptle/financial_headlines_market_based

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Used by monitoring/stream.py. API_HOST above is a BIND address (0.0.0.0) and is
# meaningless as a target, so the stream needs its own explicit URL.
API_URL=http://api:8000

# --- AWS / ECR --------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=402398991984
# Literal, not ${...}: compose cannot expand a variable defined in the same file.
ECR_REGISTRY=402398991984.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY=finbert-api
