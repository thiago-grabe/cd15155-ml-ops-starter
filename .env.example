# MLflow
# Use host.docker.internal when running inside Docker (docker compose up)
# Use localhost:5000 when running locally
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="finbert-evaluation"
MODEL_NAME="finbert"
MODEL_STAGE="production"
MODEL_ID="ProsusAI/finbert"

# Model source: "mlflow" (default) or "huggingface"
MODEL_SOURCE=mlflow
HF_MODEL_ID=ProsusAI/finbert

# AWS / ECR
AWS_REGION=""
AWS_ACCOUNT_ID=""   
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
ECR_REPOSITORY=""

# API
API_HOST=0.0.0.0
API_PORT=8000
